# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALRESCHA_MCP_URL=

# Local ingest CLI
ALRESCHA_SERVER_URL=http://localhost:3000
ALRESCHA_TOKEN=

# Supabase (required from Wave 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# GitHub App (required from Wave 1 live-integration verification)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_INSTALL_STATE_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI providers (required from Wave 4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BYOK_ENCRYPTION_KEY=

# Worker tuning (optional; both fall back to a sane default when unset)
# WORKER_CONCURRENCY: concurrent job drain loops (QW-3), default 4
# SCAN_FETCH_CONCURRENCY: blob bodies one scan fetches at once (MT-3), default 8
WORKER_CONCURRENCY=
SCAN_FETCH_CONCURRENCY=
